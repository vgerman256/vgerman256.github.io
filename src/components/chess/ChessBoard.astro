---
// The board container. Squares and pieces are created by src/scripts/chess/board-view.ts, so their
// styles below use :global().
---

<div class="board" id="board">
    <div class="squares" role="group" aria-label="Chess board. Arrow keys move, Enter selects and moves."></div>
    <div class="pieces" aria-hidden="true"></div>
</div>

<style>
    .board {
        grid-area: board;
        position: relative;
        width: var(--board-size);
        aspect-ratio: 1;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
        cursor: pointer;
    }

    .board:global(.locked) {
        cursor: default;
    }

    .squares {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template: repeat(8, 1fr) / repeat(8, 1fr);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15), var(--g-shadow);
    }

    .squares :global(.sq) {
        position: relative;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: var(--sq-light);
        cursor: inherit;
        font: inherit;
    }

    .squares :global(.sq.dark) {
        background: var(--sq-dark);
    }

    .squares :global(.sq::before),
    .squares :global(.sq::after) {
        content: '';
        position: absolute;
        pointer-events: none;
    }

    .squares :global(.sq.last-move::before) {
        inset: 0;
        background: var(--hl-last);
    }

    .squares :global(.sq.selected::before) {
        inset: 0;
        background: var(--hl-selected);
    }

    .squares :global(.sq.check) {
        background-image: radial-gradient(circle, rgb(255 30 30 / 0.95) 0%, rgb(230 0 0 / 0.6) 30%, rgb(170 0 0 / 0) 72%);
    }

    .squares :global(.sq.target::after) {
        inset: 36%;
        border-radius: 50%;
        background: var(--hl-dot);
    }

    .squares :global(.sq.target.capture::after) {
        inset: 0;
        border-radius: 0;
        background: radial-gradient(transparent 0 64%, var(--hl-dot) 65%);
    }

    .squares :global(.sq.drag-over) {
        box-shadow: inset 0 0 0 calc(var(--board-size) / 120 + 1px) rgb(255 255 255 / 0.75);
    }

    .squares :global(.sq:focus-visible) {
        z-index: 1;
        outline: 3px solid var(--g-accent);
        outline-offset: -3px;
    }

    .squares :global(.coord) {
        position: absolute;
        font: 700 clamp(8px, calc(var(--board-size) / 48), 14px) / 1 var(--font-sans);
        pointer-events: none;
    }

    .squares :global(.coord-rank) {
        top: 5%;
        left: 6%;
    }

    .squares :global(.coord-file) {
        right: 7%;
        bottom: 5%;
    }

    .squares :global(.sq.light .coord) {
        color: var(--sq-dark);
    }

    .squares :global(.sq.dark .coord) {
        color: var(--sq-light);
    }

    .pieces {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .pieces :global(.piece) {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
        width: 12.5%;
        height: 12.5%;
        translate: calc(var(--x) * 100%) calc(var(--y) * 100%);
        transition: translate 0.2s cubic-bezier(0.25, 0.8, 0.3, 1), opacity 0.2s ease, scale 0.12s ease;
        will-change: translate;
    }

    .board:global(.no-anim) .pieces :global(.piece),
    .pieces :global(.piece.snap) {
        transition: none;
    }

    .pieces :global(.piece.appear) {
        animation: piece-in 0.25s ease both;
    }

    .pieces :global(.piece.leaving) {
        z-index: 0;
        opacity: 0;
    }

    .pieces :global(.piece.dragging) {
        z-index: 10;
        scale: 1.2;
        transition: scale 0.12s ease;
        filter: drop-shadow(0 8px 8px rgb(0 0 0 / 0.35));
    }

    .board:global(.face-to-face) .pieces :global(.piece[data-piece^='b']) {
        rotate: 180deg;
    }

    @keyframes piece-in {
        from {
            opacity: 0;
            scale: 0.6;
        }
    }

    @media (max-width: 40rem) and (orientation: portrait) {
        .squares {
            border-radius: 0;
        }
    }
</style>
