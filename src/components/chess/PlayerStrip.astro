---
// One player's row above or below the board: color, name, "thinking" dots, captured pieces and material,
// and the clock when the game has one (main.ts: renderClocks).
interface Props {
    id: string;
    area: 'top' | 'bottom';
}

const { id, area } = Astro.props;
---

<div class="player-strip" id={id} style={`grid-area: ${area}`}>
    <span class="pc player-color" aria-hidden="true"></span>
    <span class="player-name"></span>
    <span class="thinking" hidden aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="captured"></span>
    <button type="button" class="clock" hidden></button>
</div>

<style>
    .player-strip {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: var(--board-size);
        height: var(--strip);
        padding: 0 0.35rem;
        font-size: 0.95rem;
        transition: rotate 0.3s ease;
    }

    .player-strip:global(.rotated) {
        rotate: 180deg;
    }

    /* Nested under .player-strip so it outranks the global `.chess-app .pc` background shorthand. */
    .player-strip .player-color {
        flex: none;
        width: calc(var(--strip) * 0.75);
        height: calc(var(--strip) * 0.75);
        border-radius: 50%;
        background-color: var(--g-surface-2);
        background-size: 85%;
        box-shadow: 0 0 0 2px transparent;
        transition: box-shadow 0.2s ease;
    }

    .player-strip:global(.to-move) .player-color {
        box-shadow: 0 0 0 2px var(--g-accent);
    }

    .player-name {
        overflow: hidden;
        font-weight: 600;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .thinking {
        display: inline-flex;
        gap: 3px;
    }

    .thinking[hidden] {
        display: none;
    }

    .thinking span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--g-accent);
        animation: dot 1s ease-in-out infinite;
    }

    .thinking span:nth-child(2) {
        animation-delay: 0.15s;
    }

    .thinking span:nth-child(3) {
        animation-delay: 0.3s;
    }

    @keyframes dot {
        0%, 80%, 100% {
            opacity: 0.25;
            scale: 0.8;
        }

        40% {
            opacity: 1;
            scale: 1;
        }
    }

    .captured {
        display: flex;
        align-items: center;
        min-width: 0;
        margin-left: auto;
        overflow: hidden;
    }

    .captured :global(.fig) {
        flex: none;
        width: calc(var(--strip) * 0.55);
        height: calc(var(--strip) * 0.55);
    }

    /* Pieces overlap a little; the first keeps its margin so the row's overflow doesn't clip it. */
    .captured :global(.fig + .fig) {
        margin-left: calc(var(--strip) * -0.18);
    }

    .captured :global(.adv) {
        margin-left: 0.35rem;
        color: var(--g-muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Waiting: dim. Running: accent, like the to-move ring. Under 20 s: red, and pulsing while it runs. */
    .clock {
        flex: none;
        min-width: calc(var(--strip) * 1.7);
        height: calc(var(--strip) * 0.78);
        padding: 0 0.45rem;
        border: 1px solid var(--g-border);
        border-radius: 8px;
        background: var(--g-surface-2);
        color: var(--g-muted);
        font: 600 calc(var(--strip) * 0.42) / 1 var(--font-mono);
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .clock[hidden] {
        display: none;
    }

    /* Before the first move and after the game there is nothing to pause. */
    .clock:disabled {
        cursor: default;
    }

    .clock:focus-visible {
        outline: 2px solid var(--g-accent);
        outline-offset: 2px;
    }

    .clock:global(.running) {
        border-color: var(--g-accent);
        background: var(--g-accent);
        color: var(--g-accent-text);
    }

    .clock:global(.low) {
        border-color: #D93025;
        color: #D93025;
    }

    .clock:global(.low.running) {
        background: #D93025;
        color: #FFF;
        animation: clock-pulse 1s ease-in-out infinite;
    }

    @keyframes clock-pulse {
        50% {
            opacity: 0.7;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .clock:global(.low.running) {
            animation: none;
        }
    }
</style>
