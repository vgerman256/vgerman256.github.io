---
import FormattedDate from './FormattedDate.astro';
import PostIcon from './PostIcon.astro';
import type { IconName } from '../lib/icons';

interface Props {
    slug: string;
    title: string;
    description: string;
    pubDate: Date;
    minutesRead?: string;
    icon?: IconName;
}

const { slug, title, description, pubDate, minutesRead, icon } = Astro.props;
---

<li class="post-item">
    {icon && <PostIcon name={icon} size={56} class="item-icon" />}
    <div>
        <p class="meta">
            <FormattedDate date={pubDate} />
            {minutesRead && <> · {minutesRead}</>}
        </p>
        <h2><a href={`/posts/${slug}/`}>{title}</a></h2>
        <p class="description">{description}</p>
    </div>
</li>

<style>
    .post-item {
        display: flex;
        align-items: flex-start;
        gap: 1.1rem;
        list-style: none;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
    }

    .post-item:first-child {
        padding-top: 0;
    }

    .item-icon {
        margin-top: 1.1rem;
    }

    .post-item h2 {
        margin: 0.35rem 0;
        font-size: 1.4rem;
    }

    .post-item h2 a {
        text-decoration: none;
    }

    .description {
        margin: 0;
        color: var(--muted);
    }
</style>
