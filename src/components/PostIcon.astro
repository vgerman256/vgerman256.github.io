---
import type { IconName } from '../lib/icons';

interface Props {
    name: IconName;
    size?: number;
    class?: string;
}

const { name, size = 96, class: className } = Astro.props;
---

<span class:list={['post-icon', className]} style={`--icon-size: ${size}px`} aria-hidden="true">
    {name === 'chess' && (
        <svg viewBox="0 0 64 64">
            <path
                class="fill-accent"
                d="M21 48 C21 41 24 37 28 33 L18 33 C15 33 13 30 14 27 L23 17 L27 9 L31 14 C41 15 47 25 46 36 L44 48 Z"
            />
            <rect class="fill-accent" x="17" y="48" width="30" height="6" rx="2" />
            <circle class="fill-bg" cx="25" cy="22" r="1.8" />
        </svg>
    )}
    {name === 'abc' && (
        <svg viewBox="0 0 64 64">
            <text class="glyph-text" x="32" y="41" text-anchor="middle">
                <tspan class="fill-accent">A</tspan>BC
            </text>
        </svg>
    )}
    {name === 'math' && (
        <svg viewBox="0 0 64 64">
            <path class="stroke-muted" d="M16 12 V50 H52" />
            <path class="stroke-accent" d="M18 40 C24 16 30 16 34 30 S44 46 50 18" />
        </svg>
    )}
    {name === 'terminal' && (
        <svg viewBox="0 0 64 64">
            <path class="stroke-accent" d="M17 22 L29 32 L17 42" />
            <path class="stroke-text" d="M33 43 H47" />
        </svg>
    )}
</span>

<style>
    .post-icon {
        display: block;
        flex-shrink: 0;
        width: var(--icon-size);
        height: var(--icon-size);
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: calc(var(--icon-size) / 8);
    }

    svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .fill-accent {
        fill: var(--accent);
    }

    .fill-bg {
        fill: var(--code-bg);
    }

    .glyph-text {
        fill: var(--text);
        font-family: var(--font-serif);
        font-size: 24px;
        font-weight: 500;
    }

    .stroke-accent,
    .stroke-muted,
    .stroke-text {
        fill: none;
        stroke-width: 4.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .stroke-accent {
        stroke: var(--accent);
    }

    .stroke-muted {
        stroke: var(--faint);
        stroke-width: 3;
    }

    .stroke-text {
        stroke: var(--text);
    }
</style>
