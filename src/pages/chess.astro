---
import GameLayout from '../layouts/GameLayout.astro';
import ChessBoard from '../components/chess/ChessBoard.astro';
import ChessDialogs from '../components/chess/ChessDialogs.astro';
import ChessIcon from '../components/chess/ChessIcon.astro';
import GameMenu from '../components/chess/GameMenu.astro';
import GamePanel from '../components/chess/GamePanel.astro';
import PlayerStrip from '../components/chess/PlayerStrip.astro';
---

<GameLayout
    title="Chess"
    description="Can you beat a chess robot? Play Stockfish running in your browser, or a friend on the same device."
>
    <div class="chess-app" id="chess-app" data-screen="menu" data-board="wood" data-pieces="cburnett">
        <header class="top-bar">
            <a class="icon-btn back" href="/games/"><ChessIcon name="back" /><span>Games</span></a>
            <span class="brand">Chess</span>
            <button type="button" class="icon-btn" id="sound-btn" aria-label="Sound effects" aria-pressed="false">
                <ChessIcon name="sound-on" class="when-on" />
                <ChessIcon name="sound-off" class="when-off" />
            </button>
            <button type="button" class="icon-btn" id="settings-btn" aria-label="Settings">
                <ChessIcon name="settings" />
            </button>
            <button type="button" class="icon-btn game-only" id="menu-btn" aria-label="Main menu">
                <ChessIcon name="menu" />
            </button>
        </header>

        <main class="screens">
            <GameMenu />
            <section class="game-screen" aria-label="Chess game">
                <PlayerStrip id="strip-top" area="top" />
                <ChessBoard />
                <button type="button" class="pause-overlay" id="pause-overlay" hidden>
                    <ChessIcon name="play" />
                    <strong>Paused</strong>
                    <span>Tap to resume</span>
                </button>
                <PlayerStrip id="strip-bottom" area="bottom" />
                <GamePanel />
            </section>
        </main>

        <ChessDialogs />
        <div class="toasts" id="toasts" popover="manual" role="status"></div>
    </div>

    <script is:inline src="/js/StockfishWeb.js"></script>
    <script>
        import '../scripts/chess/main.ts';
    </script>
</GameLayout>

<style>
    .chess-app {
        --bar: 3.25rem;
        --strip: 2.6rem;
        --gutter: 0.75rem;
        --rail: 0px;
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    }

    .top-bar {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        height: var(--bar);
        padding: 0 var(--gutter);
    }

    .brand {
        margin-right: auto;
        margin-left: 0.5rem;
        font-family: var(--font-serif);
        font-size: 1.3rem;
        font-weight: 600;
    }

    .back {
        text-decoration: none;
    }

    .back span {
        font-size: 0.9rem;
        font-weight: 500;
    }

    #sound-btn[aria-pressed='true'] :global(.when-off),
    #sound-btn[aria-pressed='false'] :global(.when-on) {
        display: none;
    }

    .chess-app[data-screen='menu'] .game-only,
    .chess-app[data-screen='menu'] .game-screen,
    .chess-app[data-screen='game'] :global(.menu-screen) {
        display: none;
    }

    .screens {
        display: flex;
        flex: 1;
        justify-content: center;
        view-transition-name: screen;
    }

    /*
     * Portrait (phones): strips, the board edge to edge, then the status, a one-row move list and the
     * action buttons. The board takes whatever height is left, so nothing scrolls during a game.
     */
    .game-screen {
        --board-size: min(
            100vw - env(safe-area-inset-left) - env(safe-area-inset-right),
            100dvh - var(--bar) - 2 * var(--strip) - 10.35rem - env(safe-area-inset-top) - env(safe-area-inset-bottom),
            40rem
        );
        display: grid;
        grid-template-columns: var(--board-size);
        grid-template-areas: 'top' 'board' 'bottom' 'panel';
        align-content: center;
        justify-content: center;
        row-gap: 0.15rem;
        padding-bottom: 0.5rem;
    }

    /* Covers the board while the clock is paused (specs/chess-clock-v2.4.md); blurred, so no free thinking. */
    .pause-overlay {
        grid-area: board;
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        border: 0;
        border-radius: 8px;
        background: color-mix(in srgb, var(--g-bg) 72%, transparent);
        backdrop-filter: blur(10px);
        color: var(--g-text);
        font: inherit;
        cursor: pointer;
    }

    .pause-overlay[hidden] {
        display: none;
    }

    .pause-overlay :global(svg) {
        width: 3rem;
        height: 3rem;
        padding: 0.75rem;
        border-radius: 50%;
        background: var(--g-accent);
        color: var(--g-accent-text);
        box-sizing: content-box;
    }

    .pause-overlay strong {
        margin-top: 0.4rem;
        font-family: var(--font-serif);
        font-size: 1.5rem;
    }

    .pause-overlay span {
        color: var(--g-muted);
        font-size: 0.9rem;
    }

    .pause-overlay:focus-visible {
        outline: 2px solid var(--g-accent);
        outline-offset: 2px;
    }

    /* Landscape (desktop, tablets, phones on their side): the panel goes beside the board. */
    @media (orientation: landscape) and (min-width: 34rem) {
        .game-screen {
            --board-size: min(
                100dvh - var(--bar) - 2 * var(--strip) - 2rem - env(safe-area-inset-top) - env(safe-area-inset-bottom),
                100vw - var(--rail) - 22rem - env(safe-area-inset-left) - env(safe-area-inset-right),
                52rem
            );
            grid-template-columns: var(--board-size) minmax(15rem, 19rem);
            grid-template-rows: auto auto auto;
            grid-template-areas: 'top panel' 'board panel' 'bottom panel';
            column-gap: 1.5rem;
            align-content: center;
            padding: 0 1.5rem 1rem;
        }
    }

    /* Phones on their side: the top bar becomes a slim icon rail on the left, so the board gets the full height. */
    @media (orientation: landscape) and (max-height: 32rem) {
        .chess-app {
            --bar: 0px;
            --rail: 3.25rem;
            --strip: 1.9rem;
            flex-direction: row;
        }

        .top-bar {
            flex-direction: column;
            width: var(--rail);
            height: auto;
            padding: 0.5rem 0;
        }

        .brand,
        .back span {
            display: none;
        }

        .back {
            margin-bottom: auto;
        }

        .screens {
            align-items: center;
        }

        .game-screen {
            padding: 0 1rem;
        }
    }
</style>

<style is:global>
    /* ---- Piece sets: each defines --wK ... --bP; [data-piece] picks one into --img. ---- */
    [data-pieces='cburnett'] {
        --wK: url('../assets/chess/pieces/cburnett/wK.svg');
        --wQ: url('../assets/chess/pieces/cburnett/wQ.svg');
        --wR: url('../assets/chess/pieces/cburnett/wR.svg');
        --wB: url('../assets/chess/pieces/cburnett/wB.svg');
        --wN: url('../assets/chess/pieces/cburnett/wN.svg');
        --wP: url('../assets/chess/pieces/cburnett/wP.svg');
        --bK: url('../assets/chess/pieces/cburnett/bK.svg');
        --bQ: url('../assets/chess/pieces/cburnett/bQ.svg');
        --bR: url('../assets/chess/pieces/cburnett/bR.svg');
        --bB: url('../assets/chess/pieces/cburnett/bB.svg');
        --bN: url('../assets/chess/pieces/cburnett/bN.svg');
        --bP: url('../assets/chess/pieces/cburnett/bP.svg');
    }

    [data-pieces='chessnut'] {
        --wK: url('../assets/chess/pieces/chessnut/wK.svg');
        --wQ: url('../assets/chess/pieces/chessnut/wQ.svg');
        --wR: url('../assets/chess/pieces/chessnut/wR.svg');
        --wB: url('../assets/chess/pieces/chessnut/wB.svg');
        --wN: url('../assets/chess/pieces/chessnut/wN.svg');
        --wP: url('../assets/chess/pieces/chessnut/wP.svg');
        --bK: url('../assets/chess/pieces/chessnut/bK.svg');
        --bQ: url('../assets/chess/pieces/chessnut/bQ.svg');
        --bR: url('../assets/chess/pieces/chessnut/bR.svg');
        --bB: url('../assets/chess/pieces/chessnut/bB.svg');
        --bN: url('../assets/chess/pieces/chessnut/bN.svg');
        --bP: url('../assets/chess/pieces/chessnut/bP.svg');
    }

    [data-piece='wK'] { --img: var(--wK); }
    [data-piece='wQ'] { --img: var(--wQ); }
    [data-piece='wR'] { --img: var(--wR); }
    [data-piece='wB'] { --img: var(--wB); }
    [data-piece='wN'] { --img: var(--wN); }
    [data-piece='wP'] { --img: var(--wP); }
    [data-piece='bK'] { --img: var(--bK); }
    [data-piece='bQ'] { --img: var(--bQ); }
    [data-piece='bR'] { --img: var(--bR); }
    [data-piece='bB'] { --img: var(--bB); }
    [data-piece='bN'] { --img: var(--bN); }
    [data-piece='bP'] { --img: var(--bP); }

    .chess-app .pc,
    .chess-app .piece {
        display: inline-block;
        background: var(--img, none) center / contain no-repeat;
    }

    /* Black piece icons (captured list, move list, review status) get a thin light outline on the dark panels. */
    @media (prefers-color-scheme: dark) {
        .chess-app .fig[data-piece^='b'] {
            filter:
                drop-shadow(0 0 0.5px rgb(255 255 255 / 0.75))
                drop-shadow(0 0 0.5px rgb(255 255 255 / 0.75));
        }
    }

    /* ---- Board themes ---- */
    [data-board] {
        --hl-last: rgb(205 210 106 / 0.55);
        --hl-selected: rgb(20 85 30 / 0.45);
        --hl-dot: rgb(20 85 30 / 0.45);
    }

    [data-board='wood'] {
        --sq-light: #F0D9B5;
        --sq-dark: #B58863;
    }

    [data-board='green'] {
        --sq-light: #EEEED2;
        --sq-dark: #769656;
        --hl-last: rgb(246 246 105 / 0.6);
    }

    [data-board='blue'] {
        --sq-light: #DEE3E6;
        --sq-dark: #8CA2AD;
        --hl-last: rgb(155 199 0 / 0.42);
        --hl-selected: rgb(20 60 120 / 0.4);
        --hl-dot: rgb(20 60 120 / 0.4);
    }

    [data-board='slate'] {
        --sq-light: #C4C8CF;
        --sq-dark: #5E6672;
        --hl-last: rgb(230 160 70 / 0.5);
        --hl-selected: rgb(216 90 48 / 0.5);
        --hl-dot: rgb(216 90 48 / 0.55);
    }

    /* ---- Shared controls ---- */
    .chess-app .btn {
        min-height: 2.75rem;
        padding: 0.55rem 1.1rem;
        border: 1px solid var(--g-border);
        border-radius: 10px;
        background: var(--g-surface-2);
        color: var(--g-text);
        font: 600 0.95rem var(--font-sans);
        cursor: pointer;
        transition: filter 0.15s ease, border-color 0.15s ease;
    }

    .chess-app .btn:hover:not(:disabled) {
        border-color: var(--g-accent);
    }

    .chess-app .btn.primary {
        border-color: var(--g-accent);
        background: var(--g-accent);
        color: var(--g-accent-text);
    }

    .chess-app .btn.primary:hover {
        filter: brightness(1.08);
    }

    .chess-app .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .chess-app .icon-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-width: 2.75rem;
        min-height: 2.75rem;
        justify-content: center;
        padding: 0 0.5rem;
        border: 0;
        border-radius: 10px;
        background: transparent;
        color: var(--g-text);
        cursor: pointer;
    }

    .chess-app .icon-btn:hover {
        background: var(--g-surface-2);
        color: var(--g-accent);
    }

    .chess-app :is(.btn, .icon-btn):focus-visible {
        outline: 2px solid var(--g-accent);
        outline-offset: 2px;
    }

    .chess-app .segmented {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .chess-app .segmented legend {
        margin-bottom: 0.35rem;
        padding: 0;
        color: var(--g-muted);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .chess-app .segmented label {
        position: relative;
        display: flex;
        flex: 1 1 0;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        min-width: max-content;
        min-height: 2.75rem;
        padding: 0.4rem 0.45rem;
        border: 1px solid var(--g-border);
        border-radius: 10px;
        background: var(--g-surface-2);
        font-size: 0.9rem;
        white-space: nowrap;
        cursor: pointer;
    }

    .chess-app .segmented input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .chess-app .segmented label:has(input:checked) {
        border-color: var(--g-accent);
        background: color-mix(in srgb, var(--g-accent) 16%, var(--g-surface));
        font-weight: 700;
    }

    .chess-app .segmented label:has(input:focus-visible) {
        outline: 2px solid var(--g-accent);
        outline-offset: 2px;
    }

    .chess-app .segmented .pc {
        width: 1.5rem;
        height: 1.5rem;
    }

    /* ---- Toasts (a manual popover, so they show above open dialogs) ---- */
    .toasts {
        position: fixed;
        inset: calc(var(--bar) + env(safe-area-inset-top) + 0.5rem) auto auto 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        width: max-content;
        max-width: calc(100vw - 2rem);
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
        overflow: visible;
        translate: -50% 0;
        pointer-events: none;
        z-index: 50;
    }

    .toasts .toast {
        padding: 0.5rem 1.1rem;
        border-radius: 999px;
        background: var(--g-text);
        color: var(--g-bg);
        font-size: 0.9rem;
        font-weight: 600;
        box-shadow: 0 6px 16px rgb(0 0 0 / 0.25);
        animation: toast-in 0.3s ease both;
        transition: opacity 0.5s ease, translate 0.5s ease;
    }

    @media (orientation: portrait) {
        .toasts .toast {
            padding: 0.35rem 0.85rem;
            font-size: 0.8rem;
        }
    }

    .toasts .toast.fade-out {
        opacity: 0;
        translate: 0 -0.5rem;
    }

    @keyframes toast-in {
        from {
            opacity: 0;
            translate: 0 0.75rem;
        }
    }

    /* ---- Win confetti (src/scripts/chess/effects.ts) ---- */
    .confetti {
        position: fixed;
        inset: 0;
        width: auto;
        height: auto;
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
        overflow: hidden;
        pointer-events: none;
        z-index: 60;
    }

    .confetti span {
        position: absolute;
        top: -16px;
        left: var(--x);
        width: var(--w);
        height: calc(var(--w) * 0.45);
        border-radius: 2px;
        background: var(--c);
        animation: confetti-fall var(--dur) cubic-bezier(0.25, 0.6, 0.4, 1) var(--delay) both;
    }

    @keyframes confetti-fall {
        to {
            translate: var(--drift) 105vh;
            rotate: var(--rot);
        }
    }

    /* The menu <-> game switch, when the View Transitions API is available. */
    ::view-transition-old(screen),
    ::view-transition-new(screen) {
        animation-duration: 0.25s;
    }
</style>
