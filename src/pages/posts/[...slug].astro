---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSortedPosts, postHref } from '../../lib/posts';

export async function getStaticPaths() {
    const posts = await getSortedPosts();
    const link = (post?: (typeof posts)[number]) => post && { title: post.data.title, href: postHref(post) };
    return posts.map((post, i) => ({
        params: { slug: post.data.slug ?? post.id },
        // The list is newest first, so the previous entry is the newer post.
        props: { post, newer: link(posts[i - 1]), older: link(posts[i + 1]) },
    }));
}

const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<PostLayout
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    minutesRead={remarkPluginFrontmatter.minutesRead}
    projectUrl={post.data.projectUrl}
    projectLabel={post.data.projectLabel}
    icon={post.data.icon}
    heroImage={post.data.heroImage}
    newer={newer}
    older={older}
>
    <Content />
</PostLayout>
