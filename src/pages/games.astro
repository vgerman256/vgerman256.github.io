---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIcon from '../components/PostIcon.astro';
import type { IconName } from '../lib/icons';

const games: { name: string; blurb: string; href: string; icon: IconName }[] = [
    {
        name: 'Chess',
        blurb: 'Play Stockfish in your browser, or a friend on the same device.',
        href: '/chess/',
        icon: 'chess',
    },
    {
        name: 'ABC Game',
        blurb: 'An alphabet game for kids, in six languages.',
        href: '/abcgame.html',
        icon: 'abc',
    },
];
---

<BaseLayout title="Games" description="Browser games built as pet projects — play them right here.">
    <p class="intro">Small browser games from my pet projects. Pick one and play.</p>
    <ul class="game-grid">
        {games.map((game) => (
            <li>
                <a class="game-tile" href={game.href}>
                    <PostIcon name={game.icon} class="game-icon" />
                    <span class="game-name">{game.name}</span>
                    <span class="game-blurb">{game.blurb}</span>
                    <span class="game-play">Play →</span>
                </a>
            </li>
        ))}
    </ul>
</BaseLayout>

<style>
    .intro {
        color: var(--muted);
    }

    .game-grid {
        list-style: none;
        padding: 0;
        margin: 2rem 0 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
    }

    @media (max-width: 480px) {
        .game-grid {
            grid-template-columns: 1fr;
        }
    }

    .game-tile {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        height: 100%;
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .game-tile:hover,
    .game-tile:focus-visible {
        color: inherit;
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .game-icon {
        margin-bottom: 0.75rem;
    }

    .game-name {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: 500;
        line-height: 1.25;
    }

    .game-blurb {
        color: var(--muted);
    }

    .game-play {
        margin-top: auto;
        padding-top: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent);
    }
</style>
