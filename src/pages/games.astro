---
import BaseLayout from '../layouts/BaseLayout.astro';

const games = [
    {
        name: 'Chess',
        blurb: 'Play against Stockfish running in your browser.',
        href: '/chess/',
        icon: 'chess',
    },
    {
        name: 'ABC Game',
        blurb: 'An alphabet game for kids, in six languages.',
        href: '/abcgame.html',
        icon: 'abc',
    },
];
---

<BaseLayout title="Games" description="Browser games built as pet projects — play them right here.">
    <p class="intro">Small browser games from my pet projects. Pick one and play.</p>
    <ul class="game-grid">
        {games.map((game) => (
            <li>
                <a class="game-tile" href={game.href}>
                    <span class="game-icon" aria-hidden="true">
                        {game.icon === 'chess' ? (
                            <svg viewBox="0 0 64 64">
                                <path
                                    class="glyph-accent"
                                    d="M21 48 C21 41 24 37 28 33 L18 33 C15 33 13 30 14 27 L23 17 L27 9 L31 14 C41 15 47 25 46 36 L44 48 Z"
                                />
                                <rect class="glyph-accent" x="17" y="48" width="30" height="6" rx="2" />
                                <circle class="glyph-eye" cx="25" cy="22" r="1.8" />
                            </svg>
                        ) : (
                            <svg viewBox="0 0 64 64">
                                <text class="glyph-text" x="32" y="41" text-anchor="middle">
                                    <tspan class="glyph-accent">A</tspan>BC
                                </text>
                            </svg>
                        )}
                    </span>
                    <span class="game-name">{game.name}</span>
                    <span class="game-blurb">{game.blurb}</span>
                    <span class="game-play">Play →</span>
                </a>
            </li>
        ))}
    </ul>
</BaseLayout>

<style>
    .intro {
        color: var(--muted);
    }

    .game-grid {
        list-style: none;
        padding: 0;
        margin: 2rem 0 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
    }

    @media (max-width: 480px) {
        .game-grid {
            grid-template-columns: 1fr;
        }
    }

    .game-tile {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        height: 100%;
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .game-tile:hover,
    .game-tile:focus-visible {
        color: inherit;
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .game-icon {
        display: block;
        width: 96px;
        height: 96px;
        margin-bottom: 0.75rem;
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .game-icon svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .glyph-accent {
        fill: var(--accent);
    }

    .glyph-eye {
        fill: var(--code-bg);
    }

    .glyph-text {
        fill: var(--text);
        font-family: var(--font-serif);
        font-size: 24px;
        font-weight: 500;
    }

    .game-name {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: 500;
        line-height: 1.25;
    }

    .game-blurb {
        color: var(--muted);
    }

    .game-play {
        margin-top: auto;
        padding-top: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent);
    }
</style>
