---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostIcon from '../components/PostIcon.astro';
import type { IconName } from '../lib/icons';

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    minutesRead?: string;
    projectUrl?: string;
    projectLabel?: string;
    icon?: IconName;
    heroImage?: ImageMetadata;
}

const {
    title,
    description,
    pubDate,
    updatedDate,
    minutesRead,
    projectUrl,
    projectLabel = 'Launch this project',
    icon,
    heroImage,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage?.src}>
    <article class="prose">
        <header>
            <p class="meta">
                <FormattedDate date={pubDate} />
                {minutesRead && <> · {minutesRead}</>}
                {updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
            </p>
            <h1>{title}</h1>
            <p class="description">{description}</p>
        </header>
        {heroImage && <Image src={heroImage} alt="" class="hero" loading="eager" />}
        <hr />
        <slot />
        {projectUrl && (
            <a class="project-card" href={projectUrl}>
                {icon && <PostIcon name={icon} size={56} />}
                <span class="project-label">{projectLabel} <span class="arrow">→</span></span>
            </a>
        )}
    </article>
</BaseLayout>

<style>
    .prose :global(h2) {
        margin-top: 2rem;
    }

    .prose :global(blockquote) {
        margin: 1.5rem 0;
        padding-left: 1rem;
        border-left: 2px solid var(--border);
        color: var(--muted);
    }

    .prose :global(pre) {
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        border: 1px solid var(--border);
    }

    .prose :global(code) {
        font-family: var(--font-mono);
        background: var(--code-bg);
        padding: 0.1em 0.35em;
        border-radius: 4px;
    }

    .prose :global(pre code) {
        background: none;
        padding: 0;
    }

    /* The max-height keeps tall phone screenshots from filling the screen; wide images hit max-width first. */
    .prose :global(img) {
        display: block;
        max-width: 100%;
        max-height: 520px;
        width: auto;
        height: auto;
        border: 1px solid var(--border);
        border-radius: 6px;
    }

    .prose .hero {
        width: 100%;
        max-height: none;
        margin-top: 1.5rem;
    }

    .prose :global(iframe) {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--border);
        border-radius: 6px;
    }

    .description {
        color: var(--muted);
    }

    /* Play card: a smaller version of the tiles on the Games page. */
    .project-card {
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        margin-top: 2rem;
        padding: 0.75rem 1.5rem 0.75rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .project-card:hover,
    .project-card:focus-visible {
        color: inherit;
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .project-label {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 500;
    }

    .arrow {
        color: var(--accent);
    }
</style>
