---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostIcon from '../components/PostIcon.astro';
import type { IconName } from '../lib/icons';

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    minutesRead?: string;
    projectUrl?: string;
    projectLabel?: string;
    icon?: IconName;
    heroImage?: ImageMetadata;
    newer?: { title: string; href: string };
    older?: { title: string; href: string };
}

const {
    title,
    description,
    pubDate,
    updatedDate,
    minutesRead,
    projectUrl,
    projectLabel = 'Launch this project',
    icon,
    heroImage,
    newer,
    older,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage?.src}>
    <article class="prose">
        <header>
            <p class="meta">
                <FormattedDate date={pubDate} />
                {minutesRead && <> · {minutesRead}</>}
                {updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
            </p>
            <h1>{title}</h1>
            <p class="description">{description}</p>
        </header>
        {heroImage && <Image src={heroImage} alt="" class="hero" loading="eager" />}
        <hr />
        <slot />
        {projectUrl && (
            <a class="project-card" href={projectUrl}>
                {icon && <PostIcon name={icon} size={56} />}
                <span class="project-label">{projectLabel} <span class="arrow">→</span></span>
            </a>
        )}
    </article>

    <nav class="post-nav" aria-label="More posts">
        <a class="all-posts" href="/">← All posts</a>
        {(newer || older) && (
            <div class="adjacent">
                {newer && (
                    <a class="adjacent-link" href={newer.href} rel="prev">
                        <span class="adjacent-label">← Newer</span>
                        <span class="adjacent-title">{newer.title}</span>
                    </a>
                )}
                {older && (
                    <a class="adjacent-link older" href={older.href} rel="next">
                        <span class="adjacent-label">Older →</span>
                        <span class="adjacent-title">{older.title}</span>
                    </a>
                )}
            </div>
        )}
    </nav>
</BaseLayout>

<style>
    .prose :global(h2) {
        margin-top: 2rem;
    }

    .prose :global(blockquote) {
        margin: 1.5rem 0;
        padding-left: 1rem;
        border-left: 2px solid var(--border);
        color: var(--muted);
    }

    .prose :global(pre) {
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        border: 1px solid var(--border);
    }

    .prose :global(code) {
        font-family: var(--font-mono);
        background: var(--code-bg);
        padding: 0.1em 0.35em;
        border-radius: 4px;
    }

    .prose :global(pre code) {
        background: none;
        padding: 0;
    }

    /* The max-height keeps tall phone screenshots from filling the screen; wide images hit max-width first. */
    .prose :global(img) {
        display: block;
        max-width: 100%;
        max-height: 520px;
        width: auto;
        height: auto;
        border: 1px solid var(--border);
        border-radius: 6px;
    }

    .prose .hero {
        width: 100%;
        max-height: none;
        margin-top: 1.5rem;
    }

    .prose :global(iframe) {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--border);
        border-radius: 6px;
    }

    .description {
        color: var(--muted);
    }

    /* Play card: a smaller version of the tiles on the Games page. */
    .project-card {
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        margin-top: 2rem;
        padding: 0.75rem 1.5rem 0.75rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .project-card:hover,
    .project-card:focus-visible {
        color: inherit;
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .project-label {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 500;
    }

    .arrow {
        color: var(--accent);
    }

    /* End-of-post navigation: back to the list, plus the neighbouring posts. */
    .post-nav {
        margin-top: 2.4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
    }

    .all-posts,
    .adjacent-label {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--muted);
    }

    .all-posts {
        text-decoration: none;
    }

    .adjacent {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .adjacent-link {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        transition: border-color 0.15s ease;
    }

    /* The older link always sits in the right column, even when there's no newer one. */
    .adjacent-link.older {
        grid-column: 2;
        text-align: right;
    }

    .adjacent-link:hover,
    .adjacent-link:focus-visible {
        color: inherit;
        border-color: var(--accent);
    }

    .adjacent-link:hover .adjacent-label,
    .all-posts:hover {
        color: var(--accent);
    }

    .adjacent-title {
        font-family: var(--font-serif);
        font-weight: 500;
        line-height: 1.3;
    }

    @media (max-width: 480px) {
        .adjacent {
            grid-template-columns: 1fr;
        }

        .adjacent-link.older {
            grid-column: 1;
        }
    }
</style>
